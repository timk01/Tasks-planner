    client.global.set("test_from", new Date().toISOString());
%}

### phase 4 - Successfully updated first task status to finished
PATCH {{baseUrlTask}}/{{test_task_id}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "header": "{{test_header}}_changed",
  "text": "{{test_text}}_changed",
  "status": "{{task_status_finished}}"
}

> {%
    client.test("Successfully updated all task fields", function () {
        const body = response.body;

        const taskId = Number(client.global.get("test_task_id"));
        const userId = Number(client.global.get("test_id"));
        const expectedHeader = client.global.get("test_header") + "_changed";
        const expectedText = client.global.get("test_text") + "_changed";

        client.assert(response.status === 200, "Response status is 200");

        client.assert(body.taskId === taskId, "Task id should remain unchanged");
        client.assert(body.header === expectedHeader, "Header should be updated");
        client.assert(body.text === expectedText, "Text should be updated");
        client.assert(body.status === "FINISHED", "Status should be updated to FINISHED");
        client.assert(body.finishedAt != null, "FinishedAt should not be null");
        client.assert(body.ownerId === userId, "Owner id should remain unchanged");
    });

    client.global.set("test_to", new Date().toISOString());
%}

### 200 - Successfully get user tasks
GET {{baseUrlTask}}/getScheduledTasks?from={{test_from}}&to={{test_to}}
TaskPlanner-Scheduler-key: {{schedulerAuthKey}}

> {%
    client.test("Successfully get user tasks", function () {
        const body = response.body;

        const userId = Number(client.global.get("test_id"));
        const email = client.global.get("test_email");

        const finishedTaskId = Number(client.global.get("test_task_id"));
        const unfinishedTaskId = Number(client.global.get("test_task_id_2"));

        const finishedHeader = client.global.get("test_header") + "_changed";
        const finishedText = client.global.get("test_text") + "_changed";

        const unfinishedHeader = client.global.get("test_header_2");
        const unfinishedText = client.global.get("test_text_2");

        client.assert(response.status === 200, "Response status is 200");
        client.assert(Array.isArray(body), "Response body should be an array");

        const userTasks = body.find(user => user.userId === userId);

        client.assert(userTasks != null, "Created user should be present in response");
        client.assert(userTasks.userId === userId, "User id should match");
        client.assert(userTasks.email === email, "User email should match");

        client.assert(Array.isArray(userTasks.finishedTasks), "Finished tasks should be an array");
        client.assert(userTasks.finishedTasks.length === 1, "Finished tasks should contain one task");

        client.assert(Array.isArray(userTasks.unfinishedTasks), "Unfinished tasks should be an array");
        client.assert(userTasks.unfinishedTasks.length === 1, "Unfinished tasks should contain one task");

        const finishedTask = userTasks.finishedTasks[0];

        client.assert(finishedTask.taskId === finishedTaskId, "Finished task id should match");
        client.assert(finishedTask.header === finishedHeader, "Finished task header should match");
        client.assert(finishedTask.text === finishedText, "Finished task text should match");
        client.assert(finishedTask.status === "FINISHED", "Finished task status should be FINISHED");
        client.assert(finishedTask.finishedAt != null, "FinishedAt should exist for finished task");
        client.assert(finishedTask.ownerId === userId, "Finished task owner id should match");

        const unfinishedTask = userTasks.unfinishedTasks[0];

        client.assert(unfinishedTask.taskId === unfinishedTaskId, "Unfinished task id should match");
        client.assert(unfinishedTask.header === unfinishedHeader, "Unfinished task header should match");
        client.assert(unfinishedTask.text === unfinishedText, "Unfinished task text should match");
        client.assert(unfinishedTask.status === "CREATED", "Unfinished task status should be CREATED");
        client.assert(unfinishedTask.finishedAt === undefined, "FinishedAt should be omitted for unfinished task");
        client.assert(unfinishedTask.ownerId === userId, "Unfinished task owner id should match");
    });
%}

