### Prereg phase 1 - Successfully create a user for future work with task
POST {{baseUrlUser}}/user
Content-Type: application/json

{
  "email": "tim_{{$timestamp}}@mail.ru",
  "password": "pass_{{$timestamp}}",
  "passwordConfirmation": "pass_{{$timestamp}}"
}

> {%
    client.global.set("test_id", response.body.id);
    client.global.set("test_email", response.body.email);

    const email = response.body.email;
    const runId = email.substring("tim_".length, email.indexOf("@"));
    client.global.set("test_password", "pass_" + runId);

    const authHeader = response.headers.valueOf("Authorization");

    client.test("Successfully create a user", function () {
        const body = response.body;
        const testId = client.global.get("test_id");
        const testEmail = client.global.get("test_email");

        client.assert(response.status === 200, "Response status is 200");
        client.assert(body.id === Number(testId), "Server should return id of user");
        client.assert(body.email === testEmail, "Server should return email of user");

        client.assert(authHeader != null, "Authorization header should exist");
        client.assert(authHeader.startsWith("Bearer "), "Authorization header should contain Bearer token");
        client.assert(authHeader.substring("Bearer ".length).length > 0, "JWT should not be empty");
    });

    client.global.set(
        "test_token",
        authHeader.substring("Bearer ".length)
    );

    client.global.set(
        "test_header",
        "header_" + runId
    );

    client.global.set(
        "test_text",
        "text_" + runId
    );

    client.global.set(
        "max_string",
        ("string_" + runId + "x".repeat(60)).substring(0, 60)
    );
%}

### phase 2 - Successfully create task
POST {{baseUrlTask}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "header": "{{test_header}}",
  "text": "{{test_text}}"
}

> {%
    client.test("Successfully created a task", function () {
        const body = response.body;
        const testHeader = client.global.get("test_header");
        const testText = client.global.get("test_text");
        const userId = Number(client.global.get("test_id"));

        client.assert(response.status === 201, "Response status is 201");

        client.assert(body.taskId != null, "Task id should exist");
        client.assert(body.header === testHeader, "Header should match");
        client.assert(body.text === testText, "Text should match");
        client.assert(body.status === "CREATED", "Status should be CREATED");
        client.assert(body.finishedAt === null, "FinishedAt should be null");
        client.assert(body.ownerId === userId, "Owner id should match");
    });
    client.global.set("test_task_id", response.body.taskId);
%}

### 200 - Nothing was changed (same status, no other fields)
PATCH {{baseUrlTask}}/{{test_task_id}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "status": "{{task_status_created}}"
}

> {%
    client.test("Nothing to update, task remains unchanged", function () {
        const body = response.body;

        const taskId = Number(client.global.get("test_task_id"));
        const userId = Number(client.global.get("test_id"));
        const expectedHeader = client.global.get("test_header");
        const expectedText = client.global.get("test_text");

        client.assert(response.status === 200, "Response status is 200");

        client.assert(body.taskId === taskId, "Task id should remain unchanged");
        client.assert(body.header === expectedHeader, "Header should remain unchanged");
        client.assert(body.text === expectedText, "Text should remain unchanged");
        client.assert(body.status === "CREATED", "Status should remain unchanged");
        client.assert(body.finishedAt === null, "FinishedAt should remain null");
        client.assert(body.ownerId === userId, "Owner id should remain unchanged");
    });
%}

### 200 - Successfully update only task header
PATCH {{baseUrlTask}}/{{test_task_id}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "header": "{{test_header}}_partial"
}

> {%
    client.test("Successfully updated only task header", function () {
        const body = response.body;

        const taskId = Number(client.global.get("test_task_id"));
        const userId = Number(client.global.get("test_id"));
        const expectedHeader = client.global.get("test_header") + "_partial";
        const expectedText = client.global.get("test_text");

        client.assert(response.status === 200, "Response status is 200");

        client.assert(body.taskId === taskId, "Task id should remain unchanged");
        client.assert(body.header === expectedHeader, "Header should be updated");
        client.assert(body.text === expectedText, "Text should remain unchanged");
        client.assert(body.status === "CREATED", "Status should remain unchanged");
        client.assert(body.finishedAt === null, "FinishedAt should remain null");
        client.assert(body.ownerId === userId, "Owner id should remain unchanged");
    });
%}

### 200 - Successfully update all editable task fields
### Main PATCH scenarios are checked here.
### Full task status transition table is covered in TaskService tests.
PATCH {{baseUrlTask}}/{{test_task_id}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "header": "{{test_header}}_changed",
  "text": "{{test_text}}_changed",
  "status": "{{task_status_in_progress}}"
}

> {%
    client.test("Successfully updated all task fields", function () {
        const body = response.body;

        const taskId = Number(client.global.get("test_task_id"));
        const userId = Number(client.global.get("test_id"));
        const expectedHeader = client.global.get("test_header") + "_changed";
        const expectedText = client.global.get("test_text") + "_changed";

        client.assert(response.status === 200, "Response status is 200");

        client.assert(body.taskId === taskId, "Task id should remain unchanged");
        client.assert(body.header === expectedHeader, "Header should be updated");
        client.assert(body.text === expectedText, "Text should be updated");
        client.assert(body.status === "IN_PROCESS", "Status should be updated to IN_PROCESS");
        client.assert(body.finishedAt === null, "FinishedAt should still be null");
        client.assert(body.ownerId === userId, "Owner id should remain unchanged");
    });
%}

