    client.global.set("test_task_id_2", response.body.taskId);
%}

### 200 - Successfully get current user's tasks
GET {{baseUrlTask}}
Authorization: Bearer {{test_token}}

> {%
    client.test("Successfully get user's tasks", function () {
        const body = response.body;

        client.assert(response.status === 200, "Response status is 200");
        client.assert(Array.isArray(body), "Server should return an array");
        client.assert(body.length === 2, "User should have exactly 2 tasks");

        const taskId1 = Number(client.global.get("test_task_id_1"));
        const taskId2 = Number(client.global.get("test_task_id_2"));
        const userId = Number(client.global.get("test_id"));

        const firstTask = body.find(task => task.taskId === taskId1);
        const secondTask = body.find(task => task.taskId === taskId2);

        client.assert(firstTask !== undefined, "First task should exist");
        client.assert(secondTask !== undefined, "Second task should exist");

        client.assert(firstTask.ownerId === userId, "First task should belong to current user");
        client.assert(firstTask.status === "CREATED", "First task status should be CREATED");

        client.assert(secondTask.ownerId === userId, "Second task should belong to current user");
        client.assert(secondTask.status === "CREATED", "Second task status should be CREATED");
    });
%}

