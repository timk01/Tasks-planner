### Prereg phase 1 - Successfully create a user for future work with task
POST {{baseUrlUser}}/user
Content-Type: application/json

{
  "email": "tim_{{$timestamp}}@mail.ru",
  "password": "pass_{{$timestamp}}",
  "passwordConfirmation": "pass_{{$timestamp}}"
}

> {%
    client.global.set("test_id", response.body.id);
    client.global.set("test_email", response.body.email);

    const email = response.body.email;
    const runId = email.substring("tim_".length, email.indexOf("@"));
    client.global.set("test_password", "pass_" + runId);

    const authHeader = response.headers.valueOf("Authorization");

    client.test("Successfully create a user", function () {
        const body = response.body;
        const testId = client.global.get("test_id");
        const testEmail = client.global.get("test_email");

        client.assert(response.status === 200, "Response status is 200");
        client.assert(body.id === Number(testId), "Server should return id of user");
        client.assert(body.email === testEmail, "Server should return email of user");

        client.assert(authHeader != null, "Authorization header should exist");
        client.assert(authHeader.startsWith("Bearer "), "Authorization header should contain Bearer token");
        client.assert(authHeader.substring("Bearer ".length).length > 0, "JWT should not be empty");
    });

    client.global.set(
        "test_token",
        authHeader.substring("Bearer ".length)
    );

    client.global.set(
        "test_header",
        "header_" + runId
    );

    client.global.set(
        "test_text",
        "text_" + runId
    );

    client.global.set(
        "max_string",
        ("string_" + runId + "x".repeat(60)).substring(0, 60)
    );
%}

### 200 - Successfully get empty task list (user is registerd, but no tasks are created yet)
GET {{baseUrlTask}}
Authorization: Bearer {{test_token}}

> {%
    client.test("Successfully get empty task list", function () {
        const body = response.body;

        client.assert(response.status === 200, "Response status is 200");
        client.assert(Array.isArray(body), "Server should return an array");
        client.assert(body.length === 0, "Task list should be empty");
    });
%}

### phase 2 - Successfully create one task
### (boundary tests for success create task test:
### min/max header = 5/60 (header is NotBlank), text = no boundaries (text is NotBlank)
POST {{baseUrlTask}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "header": "{{test_header}}",
  "text": "{{test_text}}"
}

> {%
    client.test("Successfully created a task", function () {
        const body = response.body;
        const testHeader = client.global.get("test_header");
        const testText = client.global.get("test_text");
        const userId = Number(client.global.get("test_id"));

        client.assert(response.status === 201, "Response status is 201");

        client.assert(body.taskId != null, "Task id should exist");
        client.assert(body.header === testHeader, "Header should match");
        client.assert(body.text === testText, "Text should match");
        client.assert(body.status === "CREATED", "Status should be CREATED");
        client.assert(body.finishedAt === null, "FinishedAt should be null");
        client.assert(body.ownerId === userId, "Owner id should match");
    });
    client.global.set("test_task_id_1", response.body.taskId);
%}

### phase 3 - Successfully create another task
POST {{baseUrlTask}}
Content-Type: application/json
Authorization: Bearer {{test_token}}

{
  "header": "{{test_header}}",
