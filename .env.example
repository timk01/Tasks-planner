###task-planner
POSTGRES_IMAGE=YOUR_POSTGRES_DOCKER_IMAGE

POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB
DB_HOST=db
DB_PORT=5432

KAFKA_IMAGE=YOUR_KAFKA_DOCKER_IMAGE

KAFKA_NODE_ID=YOUR_KAFKA_NODE_ID
KAFKA_PROCESS_ROLES=YOUR_KAFKA_PROCESS_ROLES
KAFKA_LISTENERS=YOUR_KAFKA_LISTENERS
KAFKA_ADVERTISED_LISTENERS=YOUR_KAFKA_OUTSIDE_LISTENERS(ADVERTISED)
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=YOUR_KAFKA_LISTENER_SECURITY_PROTOCOL_MAP
KAFKA_INTER_BROKER_LISTENER_NAME=YOUR_KAFKA_INTER_BROKER_LISTENER_NAME
KAFKA_CONTROLLER_QUORUM_VOTERS=YOUR_KAFKA_CONTROLLER_QUORUM_VOTERS
CLUSTER_ID=YOUR_CLUSTER_ID
KAFKA_CONTROLLER_LISTENER_NAMES=YOUR_KAFKA_CONTROLLER_LISTENER_NAMES
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=YOUR_KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR

JWT_SECRET=YOUR_JWT_SECRET

SCHEDULER_AUTH_HEADER=TaskPlanner-Scheduler-key
SCHEDULER_AUTH_KEY=YOUR_KEY
##header+key ARE_SUPPOSED_BE_THE_SAME_FOR_BOTH_TASKS_PLANNER_AND_SCHEDULER

###scheduler
TASK_PLANNER_BASE_URL=http://task-planner:8080

###summarizator
AUTH_KEY=your_auth_token(https://developers.sber.ru/studio/workspaces/.../gigachat-api/projects/.../settings)

###email-sender
MAIL_FROM=SENDER(MAIL_DOMAIN)
MAIL_SMTP_USERNAME=YOUR_ID(SAY_FROM_UNISENDER)
MAIL_SMTP_PASSWORD=YOUR_PASSWORD(SAY_TOKEN_FROM_UNISENDER)

KAFKA_BOOTSTRAP_SERVERS=kafka:9092